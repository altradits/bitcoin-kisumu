# Local dev works with no credentials (uses data/*.json automatically).
# To use Redis locally, fill these from Vercel dashboard → Storage → Upstash Redis,
# or run: vercel env pull .env.local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Postgres (Neon on Vercel, Docker locally). Unset = public pages and
# Redis/file-backed forms keep working; only /admin data modules need it.
# Local Docker: docker run --name bk-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=bitcoinkisumu -p 5432:5432 -d postgres:16
# Then: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bitcoinkisumu
# Vercel: Storage tab → Create → Neon Postgres → connect (adds DATABASE_URL).
DATABASE_URL=

# Admin sign-in (GitHub OAuth, allowlist only). Unset = /admin fails closed.
# 1. GitHub → Settings → Developer settings → OAuth Apps → New OAuth App.
#    Homepage: https://bitcoin-kisumu.vercel.app (or http://localhost:3000 locally).
#    Callback: https://bitcoin-kisumu.vercel.app/api/admin/callback
#    (local second app or same app with http://localhost:3000/api/admin/callback).
# 2. AUTH_SECRET: any long random string — openssl rand -hex 32.
# 3. ADMIN_GITHUB_LOGINS: comma-separated GitHub usernames, e.g. Stanley,Ivy,Paul.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=
ADMIN_GITHUB_LOGINS=
